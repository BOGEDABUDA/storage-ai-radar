# Agent 服务配置示例
# 复制为 agent/.env 后按需修改；agent/.env 已在 .gitignore 中，不会进仓库。

# DeepSeek API key（必填才能启用问答；不填时检索仍可用）
# 优先级：环境变量 DEEPSEEK_API_KEY > 本文件 > 日报脚本（只读复用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 服务监听地址与端口（默认只绑本机回环）
RADAR_AGENT_HOST=127.0.0.1
RADAR_AGENT_PORT=8787

# 问答使用的模型
RADAR_AGENT_MODEL=deepseek-v4-flash

# 检索索引位置（默认项目根目录的 insight.sqlite）
# RADAR_INDEX_PATH=/absolute/path/to/insight.sqlite

# 日报语料目录（用于「深挖原文」按日期读取 articles/）
# DAILY_REPORT_DIR=/Users/you/.openclaw/workspace/Daily Report

# 允许跨域访问的来源，逗号分隔（默认已包含 github.io 站点与本地预览端口）
# RADAR_ALLOWED_ORIGINS=https://bogedabuda.github.io,http://localhost:4173

# 可选：启用 Bearer Token 鉴权（设置后所有 /api/* 请求都需带 Authorization 头）
# RADAR_AGENT_TOKEN=change-me
